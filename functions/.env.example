# Copy to functions/.env before deploying (functions/.env is gitignored).
# These are per-deploy configuration, not secrets — the ONE secret (the GitHub
# PAT) is NOT set here; store it in Secret Manager instead:
#   firebase functions:secrets:set CMS_GITHUB_TOKEN

# Verified Google-account emails allowed to edit, comma-separated.
# FAIL-CLOSED: if unset or empty, nobody can use the API.
EDITOR_ALLOWLIST=you@example.com,teammate@example.com

# Web app config for the sign-in UI — Firebase console ▸ Project settings ▸
# General ▸ Your apps ▸ Web app. The apiKey is a public identifier, not a secret.
CMS_WEB_API_KEY=AIza...

# Optional overrides (defaults shown):
# CMS_AUTH_DOMAIN=noprofits-web.firebaseapp.com
# CMS_REPO_OWNER=noprofits-org
# CMS_REPO_NAME=noprofits-web-engineering
