---
import { EMAIL } from '../data/site.ts';
---

<footer class="np-footer">
  <div class="np-container np-footer__top">
    <div class="np-footer__brand">
      <div class="np-footer__lockup">
        <span class="np-footer__mark" aria-hidden="true">n</span>
        <span class="np-footer__word">noprofits.org</span>
      </div>
      <p class="np-footer__blurb">
        Low- and no-cost websites for non-profits across greater Seattle — built well, hosted free, and owned by you.
      </p>
    </div>
    <div class="np-footer__cols">
      <div class="np-footer__col">
        <p class="np-footer__heading">Explore</p>
        <a href="#how" class="np-footer__link">How it works</a>
        <a href="#features" class="np-footer__link">What you get</a>
        <a href="#guides" class="np-footer__link">Free guides</a>
      </div>
      <div class="np-footer__col">
        <p class="np-footer__heading">Get started</p>
        <a href="#contact" class="np-footer__link">Start your site</a>
        <a href={`mailto:${EMAIL}`} class="np-footer__link">{EMAIL}</a>
      </div>
    </div>
  </div>
  <div class="np-footer__legalwrap">
    <div class="np-container np-footer__legal">
      <span>© 2026 noprofits.org</span>
      <span>Built with Astro · Hosted on Google Workspace</span>
    </div>
  </div>
</footer>

<style>
  .np-footer { background: var(--ink); color: #aeb6af; }
  .np-footer__top {
    display: flex;
    flex-direction: column;
    gap: 36px;
    padding-top: 48px;
    padding-bottom: 36px;
  }
  .np-footer__brand { max-width: 24em; }
  .np-footer__lockup { display: flex; align-items: center; gap: 10px; }
  .np-footer__mark {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--mint);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #143f33;
    font-family: 'Bricolage Grotesque', sans-serif;
    font-weight: 800;
    font-size: 15px;
  }
  .np-footer__word {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-weight: 700;
    font-size: 19px;
    color: #f4f1ea;
  }
  .np-footer__blurb { margin: 16px 0 0; font-size: 15px; line-height: 1.6; }

  .np-footer__cols { display: flex; flex-wrap: wrap; gap: 48px; }
  .np-footer__col { display: flex; flex-direction: column; gap: 9px; }
  .np-footer__heading {
    margin: 0 0 3px;
    color: #f4f1ea;
    font-weight: 600;
    font-size: 14px;
  }
  .np-footer__link {
    color: #aeb6af;
    text-decoration: none;
    font-size: 15px;
    min-height: 24px;
    display: inline-flex;
    align-items: center;
  }
  .np-footer__link:hover { color: #f4f1ea; }

  .np-footer__legalwrap { border-top: 1px solid #2c3a32; }
  .np-footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    padding-top: 18px;
    padding-bottom: 18px;
    font-size: 13px;
    /* Lifted to ~5.6:1 on --ink (was #7e887f ~4.0:1, just under AA). */
    color: var(--on-ink-quiet);
  }

  @media (min-width: 900px) {
    .np-footer__top {
      flex-direction: row;
      justify-content: space-between;
      gap: 40px;
      padding-top: 54px;
      padding-bottom: 40px;
    }
    .np-footer__cols { gap: 64px; }
  }
</style>
