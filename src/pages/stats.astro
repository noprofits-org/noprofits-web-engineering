---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_NAME, DASH_URL, hasDashboard } from '../data/site.ts';

const title = 'Live site stats (a demo) | noprofits.org';
const description =
  'A live demonstration of the private, cookieless analytics we build into every site — page views, visits, inquiries, and phone clicks, with no third-party tracking.';
const path = '/stats/';
---

<BaseLayout title={title} description={description} path={path}>
  <Header />
  <main id="main" class="np-stats">
    <div class="np-container np-stats__inner">
      <p class="np-eyebrow">Live demo</p>
      <h1 class="np-stats__h1">See the analytics, live</h1>

      <div class="np-stats__callout">
        <p class="np-stats__callout-p">
          Every {SITE_NAME} site can quietly measure whether it's working &mdash; how many people
          visit, where they come from, and how many reach out. For your organization those figures
          are <strong>private by default</strong>, visible only to you in your own Google Sheet. To
          prove the feature is real, we publish <strong>our own</strong> numbers on a live dashboard.
        </p>
      </div>

      <p class="np-stats__lead">
        It's anonymous and aggregate &mdash; page views, visits, inquiry-form submissions, and phone
        clicks &mdash; with <strong>no cookies, no Google Analytics, and no third parties</strong>
        tracking anyone. The dashboard reads straight from the sheet, so it's always current.
      </p>

      {hasDashboard ? (
        <p class="np-stats__cta-wrap">
          <a class="np-stats__cta" href={DASH_URL} target="_blank" rel="noopener">Open the live dashboard →</a>
          <span class="np-stats__cta-note">Opens in a new tab. You'll be asked to sign in with a Google account &mdash; a light screen that keeps bots out; we never see who you are.</span>
        </p>
      ) : (
        <p class="np-stats__lead"><em>The live dashboard isn't connected yet &mdash; check back soon.</em></p>
      )}

      <p class="np-stats__foot">
        Figures are anonymous and aggregate &mdash; no name, email, message, or cross-site identifier
        is ever part of this data. Read the <a href="/privacy/">privacy policy</a> for exactly what
        is and isn't collected.
      </p>
    </div>
  </main>

  <Footer />

  <style>
    .np-stats { background: #e9ece8; min-height: 100vh; padding: 0 0 56px; }
    .np-stats__inner { max-width: 760px; padding-top: 40px; padding-bottom: 0; }
    .np-stats__h1 {
      font-family: 'Bricolage Grotesque', sans-serif;
      font-weight: 800;
      font-size: 32px;
      line-height: 1.08;
      letter-spacing: -0.02em;
      color: var(--ink);
      margin: 8px 0 0;
    }
    .np-stats__callout {
      margin: 22px 0 0;
      background: var(--sky-tint);
      border: 1px solid var(--sky-soft);
      border-radius: 14px;
      padding: 20px 22px;
    }
    .np-stats__callout-p { margin: 0; font-size: 16px; line-height: 1.7; color: #2f3a34; }
    .np-stats__lead { margin: 20px 0 0; font-size: 16px; line-height: 1.7; color: var(--slate); }

    .np-stats__cta-wrap { margin: 28px 0 0; display: flex; flex-direction: column; gap: 10px; align-items: flex-start; }
    .np-stats__cta {
      display: inline-block;
      background: var(--accent);
      color: #fff;
      font-weight: 700;
      font-size: 16px;
      text-decoration: none;
      padding: 13px 22px;
      border-radius: 10px;
      min-height: 44px;
    }
    .np-stats__cta:hover { background: var(--accent-deep); }
    .np-stats__cta-note { font-size: 13px; color: var(--faint); line-height: 1.6; }

    .np-stats__foot {
      margin: 32px 0 0;
      font-size: 13px;
      line-height: 1.7;
      color: var(--faint);
    }
    .np-stats__foot a { color: var(--accent-deep); }

    @media (min-width: 680px) {
      .np-stats__h1 { font-size: 40px; }
    }
  </style>
</BaseLayout>
