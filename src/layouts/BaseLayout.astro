---
import '../styles/global.css';
import {
  SITE_NAME,
  SITE_DESCRIPTION,
  SITE_URL,
  PHONE_TEL,
  EMAIL,
  AREA_SERVED,
  OG_IMAGE_PATH,
} from '../data/site.ts';

interface Props {
  title: string;
  description?: string;
  /** Path of the current page for canonical/OG, e.g. "/" or "/guides/..." */
  path?: string;
  ogType?: string;
  /** Optional per-page JSON-LD object(s): Service, Article, etc. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Emit a per-page noindex robots meta (e.g. the 404). */
  noindex?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  path = '/',
  ogType = 'website',
  jsonLd,
  noindex = false,
} = Astro.props;

const canonical = new URL(path, SITE_URL).href;
const ogImage = new URL(OG_IMAGE_PATH, SITE_URL).href;

// Site-wide Organization schema — emitted on every page.
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_NAME,
  url: SITE_URL,
  logo: {
    '@type': 'ImageObject',
    url: new URL('/logo.png', SITE_URL).href,
    width: 512,
    height: 512,
  },
  description: SITE_DESCRIPTION,
  email: EMAIL,
  areaServed: { '@type': 'AdministrativeArea', name: AREA_SERVED },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: PHONE_TEL,
    email: EMAIL,
    contactType: 'customer service',
    areaServed: 'US-WA',
  },
};

// Normalize any per-page JSON-LD into an array for clean iteration.
const pageLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#16221D" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/*
      PRE-LAUNCH noindex TOGGLE — this is a real, public, indexable site, so the
      tag below is commented out. Uncomment the single line to take the site out
      of search results before launch, then re-comment to go live.
    */}
    {/* <meta name="robots" content="noindex, nofollow" /> */}
    {noindex && <meta name="robots" content="noindex" />}

    <!-- Open Graph / social -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="noprofits.org — free websites for non-profits" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured data: site-wide Organization + any per-page schema. -->
    <script type="application/ld+json" set:html={JSON.stringify(orgLd).replace(/</g, '\\u003c')} />
    {pageLd.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj).replace(/</g, '\\u003c')} />
    ))}

    <!-- Fonts: self-hosted (latin subset) — @font-face lives in global.css.
         Preload the heading font (LCP H1 uses Bricolage Grotesque). -->
    <link
      rel="preload"
      href="/fonts/bricolage-grotesque.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/hanken-grotesk.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <a class="np-skiplink" href="#main">Skip to content</a>
    <slot />

    {/* First-party, cookieless analytics — no-ops unless PUBLIC_ANALYTICS_ENDPOINT
        is set. Records a pageview + tel-link clicks; see src/lib/analytics.ts. */}
    <script>
      import { initAnalytics } from '../lib/analytics.ts';
      initAnalytics();
    </script>
  </body>
</html>
